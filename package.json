{
  "name": "freebuff-auth",
  "version": "0.2.0",
  "private": true,
  "description": "Freebuff provider for magpie and DeepSeek Harness — device signing, multi-account pool, streaming tool calls",
  "type": "module",
  "workspaces": ["packages/*"],
  "scripts": {
    "test": "node scripts/test.mjs",
    "pack:magpie": "npm pack --workspace magpie-freebuff-provider --pack-destination dist",
    "pack:dsh": "npm pack --workspace dsh-freebuff-provider --pack-destination dist",
    "pack:all": "npm run pack:core && npm run pack:magpie && npm run pack:dsh",
    "pack:core": "npm pack --workspace freebuff-core --pack-destination dist",
    "gateway": "node packages/dsh/gateway.mjs"
  },
  "keywords": ["freebuff", "codebuff", "magpie", "dsh", "opencode"],
  "license": "MIT",
  "author": "Freebuff provider plugin contributors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MYCF711/freebuff-auth.git"
  }
}
